# Copy to .env.local for local builds, or set as GitHub repository variables for deployment.
# None of these values are secret: they end up in the public website.

# Full public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://snturco.com

# Only needed when the site is served from a sub-path, e.g. https://ikasnturco.github.io/snturco-website
# Leave empty when a custom domain is used.
NEXT_PUBLIC_BASE_PATH=

# Form endpoint (free tier of Web3Forms, Formspree or similar). Leave empty to use the
# email fallback: the form then opens the visitor's email program instead.
NEXT_PUBLIC_FORM_ENDPOINT=
# Web3Forms only: public access key (safe to expose, it only allows sending to your inbox).
NEXT_PUBLIC_FORM_ACCESS_KEY=
